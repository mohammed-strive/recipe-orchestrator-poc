      },
      "outputs": {
        "usd_actuals": "table/usd-actuals@1"
      },
      "tags": [
        "finance",
        "fx",
        "currency",
        "conversion",
        "usd"
      ],
      "examples": [
        "Convert revenue to USD"
      ]
    }
  ]
