# Copy to .env (read by `npm start` in engine/). All values below are the defaults.

# claude: AI steps run in headless Claude Code sessions using your Claude Code login.
# stub:   AI steps produce placeholder output (no model, no cost) to test the plumbing.
AGENT_RUNNER=claude
# claude: an LLM reranks discovery candidates. none: retrieval scores only.
RERANK=claude
# Model for AI steps when a recipe does not pin one, and for reranking and card generation.
DEFAULT_MODEL=claude-sonnet-5-5
CLAUDE_BIN=claude
PYTHON_BIN=python3

# central: audit events also go to Postgres. local: run directory only.
AUDIT_MODE=central

ENGINE_PORT=7400
DATABASE_URL=postgres://poc:poc@localhost:5433/orchestrator
REGISTRY_URL=http://localhost:7300/mcp
EMBEDDINGS_URL=http://localhost:7200
GIT_BASE_URL=git://localhost:9418
HOST_NAME=claude-code
