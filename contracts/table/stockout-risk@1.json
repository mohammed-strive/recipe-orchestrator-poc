{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "table/stockout-risk@1",
  "title": "table/stockout-risk@1",
  "description": "Stock-out risk per store",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "store": {
        "type": "string"
      },
      "forecast_units": {
        "type": "number"
      },
      "on_hand": {
        "type": "integer"
      },
      "cover_weeks": {
        "type": "number"
      },
      "risk": {
        "enum": [
          "low",
          "medium",
          "high"
        ]
      }
    },
    "required": [
      "store",
      "forecast_units",
      "on_hand",
      "cover_weeks",
      "risk"
    ],
    "additionalProperties": true
  }
}
