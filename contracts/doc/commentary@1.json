{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "doc/commentary@1",
  "title": "doc/commentary@1",
  "description": "Analyst-style commentary on a set of results",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "highlights": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "narrative": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "highlights",
    "risks",
    "narrative"
  ]
}
